# LLM Provider API Keys
GROQ_API_KEY=gsk_xxx
GEMINI_API_KEY=xxx
MISTRAL_API_KEY=xxx

# Supabase Postgres connection string (psycopg URI format)
# Get from: Supabase Dashboard -> Settings -> Database -> Connection string
SUPABASE_DB_URI=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# Supabase direct connection (port 5432, bypasses pgbouncer DNS propagation lag on new projects)
# Try this first if SUPABASE_DB_URI fails with ENOTFOUND within 24h of project creation
# Get from: Supabase Dashboard -> Settings -> Database -> Direct connection
SUPABASE_DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Real channels — SMS via Semaphore PH (Phase 4)
SEMAPHORE_API_KEY=your_semaphore_key
SEMAPHORE_SENDER_NAME=OttoBot
# Facebook Messenger (Phase 4)
META_PAGE_ACCESS_TOKEN=your_meta_page_token
FACEBOOK_VERIFY_TOKEN=your_verify_token
# Business ID for channel webhooks (Phase 5 will replace with auth)
BUSINESS_ID=
DEFAULT_INDUSTRY=dental
OUTBOUND_GREETING=Magandang araw po! Ako si OttoBot, tumutulong po ako para sa inyong appointment.

# Business owner escalation email (Phase 3)
RESEND_API_KEY=re_xxx
RESEND_TO_EMAIL=owner@example.com
RESEND_FROM_EMAIL=ottobot@noreply.ottobot.app

# Arize Phoenix tracing host
PHOENIX_HOST=http://localhost:6006

# LiteLLM log level (set to ERROR in production to suppress API key logging)
LITELLM_LOG=ERROR
