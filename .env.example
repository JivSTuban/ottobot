# LLM Provider API Keys
GROQ_API_KEY=gsk_xxx
GEMINI_API_KEY=xxx
MISTRAL_API_KEY=xxx

# Neon Postgres connection strings
# Get from: Neon console → Project → Connection string
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.neon.tech/ottobot?sslmode=require
# Direct connection (bypasses pooler for migrations)
DATABASE_DIRECT_URL=postgresql://user:pass@ep-xxx.neon.tech/ottobot?sslmode=require

# Clerk auth (JWKS for token verification)
# Get from: Clerk dashboard → API Keys → JWKS Public Key URL
CLERK_JWKS_URL=https://<your-clerk-subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-subdomain>.clerk.accounts.dev

# Real channels — SMS via Semaphore PH (Phase 4)
SEMAPHORE_API_KEY=your_semaphore_key
SEMAPHORE_SENDER_NAME=OttoBot
# Facebook Messenger (Phase 4)
META_PAGE_ACCESS_TOKEN=your_meta_page_token
FACEBOOK_VERIFY_TOKEN=your_verify_token
# Business ID for channel webhooks (Phase 5 will replace with auth)
BUSINESS_ID=
DEFAULT_INDUSTRY=dental
OUTBOUND_GREETING=Magandang araw po! Ako si OttoBot, tumutulong po ako para sa inyong appointment.

# Business owner escalation email (Phase 3)
RESEND_API_KEY=re_xxx
RESEND_TO_EMAIL=owner@example.com
RESEND_FROM_EMAIL=ottobot@noreply.ottobot.app

# Arize Phoenix tracing host
PHOENIX_HOST=http://localhost:6006

# LiteLLM log level (set to ERROR in production to suppress API key logging)
LITELLM_LOG=ERROR
